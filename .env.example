# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env
#   chmod 600 .env
#
# Файл .env исключён из Git — см. .gitignore

# Пароль администратора Grafana (логин admin).
# Задаётся только при ПЕРВОЙ инициализации базы. При последующей смене
# значения нужен сброс:
#   docker compose exec grafana grafana cli admin reset-admin-password 'новый'
GRAFANA_PASSWORD=

# Имя хоста для меток логов. Заполни своим:
#   echo "HOSTNAME=$(hostname)" >> .env
HOSTNAME=