[Unit]
Description=Стек мониторинга (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/eakramar/lab6/monitoring
# в копии для репозитория путь заменяется плейсхолдером
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down --timeout 30
ExecReload=/usr/bin/docker compose up -d --force-recreate
TimeoutStartSec=300
User=
Group=docker

[Install]
WantedBy=multi-user.target
